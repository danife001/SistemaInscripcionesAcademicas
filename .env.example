# Copia este archivo como .env y define una contraseña propia antes de arrancar.
# Usa al menos 16 caracteres con mayúsculas, minúsculas, números y símbolos.
# Evita ; y comillas porque la contraseña se usa en una cadena de conexión.
MSSQL_SA_PASSWORD=CAMBIA_ESTA_CLAVE_123!
WEB_PORT=8080
API_PORT=5234
SQL_PORT=14333
# Development permite Swagger en este entorno local de evaluación.
APP_ENVIRONMENT=Development

# Opcional: crear la cuenta administrativa inicial (ver docs/administrador.md).
ADMIN_CREAR_AL_INICIAR=false
ADMIN_CORREO=
ADMIN_NOMBRE=Administrador
ADMIN_PASSWORD=
